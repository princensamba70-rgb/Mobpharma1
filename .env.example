# AMI PHARMA — variables de déploiement
# Copiez ce fichier vers .env puis renseignez des valeurs uniques et longues.
POSTGRES_PASSWORD=CHANGEZ_CETTE_VALEUR
JWT_ACCESS_SECRET=REMPLACEZ_PAR_UN_SECRET_ALEATOIRE_D_AU_MOINS_32_CARACTERES
JWT_REFRESH_SECRET=REMPLACEZ_PAR_UN_AUTRE_SECRET_ALEATOIRE_D_AU_MOINS_32_CARACTERES

# Obligatoires au premier seed uniquement. Ne les committez jamais.
ADMIN_INITIAL_PASSWORD=
FINANCE_INITIAL_PASSWORD=
ASSISTANT_INITIAL_PASSWORD=

WEB_PORT=8080
API_PORT=4001
NODE_ENV=production
CORS_ORIGIN=https://localhost,capacitor://localhost
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
CURRENCY=CDF
LOCALE=fr-FR

# Build Android (à définir dans frontend/.env.production ou la commande de build)
# VITE_API_URL=https://votre-api-ami-pharma.example.com
