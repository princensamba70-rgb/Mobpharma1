# URL publique de l'API AMI PHARMA, sans le suffixe /api.
# Web local : laissez vide pour utiliser le proxy Vite (/api -> localhost:4000).
# Android émulateur : http://10.0.2.2:4000.
# Android physique peut utiliser http:// si le serveur et le build l'autorisent ;
# HTTPS reste recommandé pour protéger les identifiants en transit.
VITE_API_URL=
